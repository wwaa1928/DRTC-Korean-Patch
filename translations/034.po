msgctxt "deathforth/events/common/common1.df"
msgid ": MEDICAL INTERVENTION"
msgstr ": 의료 개입"

#: deathforth/events/common/common1.df:17
msgctxt "deathforth/events/common/common1.df"
msgid "Afterwards, "
msgstr "그 후,"

#: deathforth/events/common/common1.df:21
msgctxt "deathforth/events/common/common1.df"
msgid "CAR ARMOR UP!"
msgstr "차량 장갑 강화!"

#: deathforth/events/common/common1.df:215
msgctxt "deathforth/events/common/common1.df"
msgid "Despite the pushiness, "
msgstr "좀 지나치긴 했지만"

#: deathforth/events/common/common1.df:138
msgctxt "deathforth/events/common/common1.df"
msgid ""
"In the middle of the apocalypse, getting the rare opportunity to nuzzle a "
"deer completely restores "
msgstr "세상이 망한 와중에 사슴에게 얼굴을 비벼 볼 기회라니. 덕분에"

