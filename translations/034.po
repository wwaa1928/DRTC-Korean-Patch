msgctxt "deathforth/events/common/common1.df"
msgid "It's trivial for "
msgstr "<EMPTY>"

#: deathforth/events/common/common1.df:137
msgctxt "deathforth/events/common/common1.df"
msgid "The deer slowly approaches "
msgstr "<EMPTY>"

