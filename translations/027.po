msgctxt "deathforth/events/trade/trader-camp-region-special6.df"
msgid "It's not YOUR turret!"
msgstr "네 포탑이 아니다!"

#: deathforth/events/trade/trader-camp-region-special6.df:86
msgctxt "deathforth/events/trade/trader-camp-region-special6.df"
msgid "Leave it be"
msgstr "그냥 둔다"

#: deathforth/events/trade/trader-camp-region-special6.df:87
msgctxt "deathforth/events/trade/trader-camp-region-special6.df"
