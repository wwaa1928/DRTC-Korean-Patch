msgctxt "deathforth/events/trade/trader-camp-region-special6.df"
msgid "Bazooka XL - 8 shots - 12 food"
msgstr "바주카 XL - 8발 - 식량 12개"

#: deathforth/events/trade/trader-camp-region-special6.df:128
msgctxt "deathforth/events/trade/trader-camp-region-special6.df"
msgid "Grenade Launcher XL - 15 shots - 12 food"
