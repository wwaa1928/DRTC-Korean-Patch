msgctxt "deathforth/events/rareloc/panda.df"
msgid "Panda Panic"
msgstr "판다 패닉"

#: deathforth/events/rareloc/panda.df:62
msgctxt "deathforth/events/rareloc/panda.df"
msgid "It's a panda, standing around the trashed building. It stares at "
