msgctxt "deathforth/events/finale/end-of-the-road.df"
msgid "Artists: "
msgstr "아트: "

#: deathforth/events/finale/end-of-the-road.df:678
msgctxt "deathforth/events/finale/end-of-the-road.df"
msgid "Musician: "
msgstr "음악: "

#: deathforth/events/finale/end-of-the-road.df:685
msgctxt "deathforth/events/finale/end-of-the-road.df"
msgid "THANK YOU FOR PLAYING!"
msgstr "플레이해 주셔서 감사합니다!"

#: deathforth/events/finale/ending-bits.df:10
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Sooooo... this is Canada eh"
msgstr "그러니까아... 여기가 캐나다구나, 응"

#: deathforth/events/finale/ending-bits.df:12
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Guess I made it alone."
msgstr "혼자서 해낸 것 같네."

#: deathforth/events/finale/ending-bits.df:14
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Yup."
msgstr "그래."

#: deathforth/events/finale/ending-bits.df:17
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "It's a bit... brisk"
msgstr "좀... 쌀쌀하네"

#: deathforth/events/finale/ending-bits.df:20
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Oh, well."
msgstr "뭐, 어쩔 수 없지."

#: deathforth/events/finale/ending-bits.df:22
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Ya think?"
msgstr "그렇게 생각해?"

#: deathforth/events/finale/ending-bits.df:29
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Hey look! Penguins!!"
msgstr "저기 봐! 펭귄이다!!"

#: deathforth/events/finale/ending-bits.df:35
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Wait what"
msgstr "잠깐 뭐"

#: deathforth/events/finale/ending-bits.df:36
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What?"
msgstr "뭐?"

#: deathforth/events/finale/ending-bits.df:37
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "There are no penguins in Canada..."
msgstr "캐나다엔 펭귄 없어..."

#: deathforth/events/finale/ending-bits.df:38
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "But... ice, snow... PENGUINS! "
msgstr "그치만... 얼음, 눈... 펭귄! "

#: deathforth/events/finale/ending-bits.df:39
#: deathforth/events/finale/ending-bits.df:313
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "...sigh"
msgstr "...한숨"

#: deathforth/events/finale/ending-bits.df:45
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What a long road!"
msgstr "정말 긴 길이었다!"

#: deathforth/events/finale/ending-bits.df:48
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "That felt like it took an eternity."
msgstr "영원처럼 느껴졌어."

#: deathforth/events/finale/ending-bits.df:49
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Oh well."
msgstr "뭐, 어쩔 수 없지."

#: deathforth/events/finale/ending-bits.df:50
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "At least I made it!"
msgstr "적어도 도착은 했잖아!"

#: deathforth/events/finale/ending-bits.df:52
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Remind me..."
msgstr "다시 말해 봐..."

#: deathforth/events/finale/ending-bits.df:53
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Who's idea was it to take the long way, again?"
msgstr "먼 길로 가자고 한 게 누구였더라?"

#: deathforth/events/finale/ending-bits.df:54
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "...shut up."
msgstr "...닥쳐."

#: deathforth/events/finale/ending-bits.df:55
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What a pleasant time in Canada you two will have, eh?"
msgstr "너희 둘, 캐나다에서 참 즐겁게 지내겠구나, 응?"

#: deathforth/events/finale/ending-bits.df:62
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I met a bunch of weirdos!"
msgstr "이상한 녀석들을 잔뜩 만났어!"

#: deathforth/events/finale/ending-bits.df:65
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Awh, dang! I just remembered."
msgstr "아, 젠장! 방금 생각났다."

#: deathforth/events/finale/ending-bits.df:66
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I didn't get their twitter handles..."
msgstr "걔네 트위터 아이디를 못 받았어..."

#: deathforth/events/finale/ending-bits.df:68
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I wonder if there are more weirdos out there?"
msgstr "저 밖에 이상한 녀석들이 더 있을까?"

#: deathforth/events/finale/ending-bits.df:69
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Yeah, more DINKS, maybe."
msgstr "그래, 얼간이들이 더 있겠지, 아마."

#: deathforth/events/finale/ending-bits.df:72
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "They'd better have passports too!"
msgstr "그 녀석들도 여권은 있어야 할 텐데!"

#: deathforth/events/finale/ending-bits.df:78
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I saw a lot of familiar faces!"
msgstr "낯익은 얼굴들을 많이 봤어!"

#: deathforth/events/finale/ending-bits.df:81
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "...not that I liked them very much."
msgstr "...딱히 좋아하진 않았지만."

#: deathforth/events/finale/ending-bits.df:82
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "FINALLY, I CAN GET AWAY FROM THESE DINKS."
msgstr "드디어 이 얼간이들한테서 벗어날 수 있다."

#: deathforth/events/finale/ending-bits.df:84
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "They didn't look very familiar to me."
msgstr "난 별로 낯익지 않던데."

#: deathforth/events/finale/ending-bits.df:85
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Mhm, well, you need your eyes checked."
msgstr "음, 그래, 넌 눈 검사 좀 받아야겠다."

#: deathforth/events/finale/ending-bits.df:88
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Who knows who was left behind by the apocalypse?"
msgstr "종말에 누가 남겨졌는지 누가 알겠어?"

#: deathforth/events/finale/ending-bits.df:94
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I did it!"
msgstr "해냈다!"

#: deathforth/events/finale/ending-bits.df:95
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "And I met so many interesting people on the way!"
msgstr "오는 길에 흥미로운 사람들을 정말 많이 만났어!"

#: deathforth/events/finale/ending-bits.df:96
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "...and some, admittedly REAL DARN STINKY people, too."
msgstr "...그리고 솔직히 진짜 엄청 냄새나는 사람들도."

#: deathforth/events/finale/ending-bits.df:97
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Ahh...I miss soap..."
msgstr "아아... 비누가 그립다..."

#: deathforth/events/finale/ending-bits.df:103
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Good thing I had all my friends!"
msgstr "친구들이 다 있어서 다행이야!"

#: deathforth/events/finale/ending-bits.df:106
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Well, I used to..."
msgstr "뭐, 있었지..."

#: deathforth/events/finale/ending-bits.df:107
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Guess I'll have to make some new ones."
msgstr "새 친구를 사귀어야겠네."

#: deathforth/events/finale/ending-bits.df:108
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I'll be your friend!"
msgstr "내가 친구가 되어 줄게!"

#: deathforth/events/finale/ending-bits.df:109
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Love wins."
msgstr "사랑이 이긴다."

#: deathforth/events/finale/ending-bits.df:111
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What would I do without you?"
msgstr "너 없으면 난 어떡하지?"

#: deathforth/events/finale/ending-bits.df:112
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Don't make this weird."
msgstr "이상하게 만들지 마."

#: deathforth/events/finale/ending-bits.df:113
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Okay..."
msgstr "알았어..."

#: deathforth/events/finale/ending-bits.df:120
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I have defeated... K*E*P*A MODE!"
msgstr "내가 해냈다... K*E*P*A 모드를!"

#: deathforth/events/finale/ending-bits.df:122
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Keep-Everybody's-Pears-Always Mode, right?"
msgstr "'케(K)이크는 에(E)브리바디가 피(P)자처럼 아(A)껴 먹자' 모드 맞지?"

#: deathforth/events/finale/ending-bits.df:123
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "or...Kill Electric Ponies Always Mode?..."
msgstr "아니면... '킬(K) 전(E)기 포(P)니 언제나(A)' 모드?..."

#: deathforth/events/finale/ending-bits.df:124
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Gahh, I forget."
msgstr "아, 까먹었다."

#: deathforth/events/finale/ending-bits.df:125
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Survivors these days..."
msgstr "요즘 생존자들이란..."

#: deathforth/events/finale/ending-bits.df:131
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Speed run complete!"
msgstr "스피드런 완료!"

#: deathforth/events/finale/ending-bits.df:132
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Did I beat my best time?"
msgstr "최고 기록 깼나?"

#: deathforth/events/finale/ending-bits.df:133
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Nope, I don't think so."
msgstr "아니, 못 깬 것 같은데."

#: deathforth/events/finale/ending-bits.df:134
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "DAMN IT "
msgstr "젠장 "

#: deathforth/events/finale/ending-bits.df:140
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "That was a pretty big detour!"
msgstr "꽤 큰 우회로였어!"

#: deathforth/events/finale/ending-bits.df:141
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I'm exhausted! I need a drink."
msgstr "지쳤다! 한잔해야겠어."

#: deathforth/events/finale/ending-bits.df:142
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "OR SEVERAL! "
msgstr "아니면 여러 잔! "

#: deathforth/events/finale/ending-bits.df:145
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Mhm...better make it several."
msgstr "음... 여러 잔이 낫겠다."

#: deathforth/events/finale/ending-bits.df:152
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "That was fairly deadly!"
msgstr "꽤 치명적이었어!"

#: deathforth/events/finale/ending-bits.df:154
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You could even say it was a death road."
msgstr "죽음의 길이었다고 해도 되겠는데."

#: deathforth/events/finale/ending-bits.df:155
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "...a Death Road to Canada, even."
msgstr "...캐나다로 가는 죽음의 길이라고 해도."

#: deathforth/events/finale/ending-bits.df:156
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Roll credits. Oh, wait..."
msgstr "크레딧 올려. 아, 잠깐..."

#: deathforth/events/finale/ending-bits.df:162
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Road triiiiip!"
msgstr "로드 트리이이입!"

#: deathforth/events/finale/ending-bits.df:165
msgctxt "deathforth/events/finale/ending-bits.df"
msgid ""
"Would've been a much better trip if there was somebody to share it with."
msgstr "같이 나눌 사람이 있었으면 훨씬 좋은 여행이었을 텐데."

#: deathforth/events/finale/ending-bits.df:166
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Nevermind..."
msgstr "됐다..."

#: deathforth/events/finale/ending-bits.df:167
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I'm right here, eh!"
msgstr "나 여기 있잖아, 응!"

#: deathforth/events/finale/ending-bits.df:168
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I feel so lonely..."
msgstr "너무 외로워..."

#: deathforth/events/finale/ending-bits.df:170
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "We made it! Together!"
msgstr "해냈다! 함께!"

#: deathforth/events/finale/ending-bits.df:171
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "But I did all the work?"
msgstr "근데 일은 내가 다 했잖아?"

#: deathforth/events/finale/ending-bits.df:172
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "IN YOUR DREAMS, JERK!"
msgstr "꿈 깨, 얼간아!"

#: deathforth/events/finale/ending-bits.df:173
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Ahhh, friendship..."
msgstr "아아, 우정이란..."

#: deathforth/events/finale/ending-bits.df:180
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "ROAAAD TRIIIIP EXTREEEEME!"
msgstr "로오오드 트리이이입 익스트리이이임!"

#: deathforth/events/finale/ending-bits.df:181
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Didn't seem that extreme to me, eh?"
msgstr "나한텐 별로 익스트림해 보이지 않던데, 응?"

#: deathforth/events/finale/ending-bits.df:182
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You had NO idea."
msgstr "넌 전혀 모를 거야."

#: deathforth/events/finale/ending-bits.df:183
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "It was horrible!"
msgstr "끔찍했다고!"

#: deathforth/events/finale/ending-bits.df:186
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Guess that explains why you're alone."
msgstr "그래서 혼자인가 보구나."

#: deathforth/events/finale/ending-bits.df:192
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Why do I suddenly feel so...tired?"
msgstr "왜 갑자기 이렇게... 피곤하지?"

#: deathforth/events/finale/ending-bits.df:193
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You're not about to explode, are you?"
msgstr "설마 폭발하려는 건 아니지?"

#: deathforth/events/finale/ending-bits.df:194
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "No? Why, should I be? "
msgstr "아니? 왜, 그래야 돼? "

#: deathforth/events/finale/ending-bits.df:195
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Oh. No reason."
msgstr "아. 그냥 물어봤어."

#: deathforth/events/finale/ending-bits.df:201
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Wow, so many roleplayers these days."
msgstr "와, 요즘 역할극 하는 사람 참 많네."

#: deathforth/events/finale/ending-bits.df:202
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You must be here for the jerk convention."
msgstr "얼간이 컨벤션 때문에 온 거구나."

#: deathforth/events/finale/ending-bits.df:203
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "RIGHT THIS WAY!"
msgstr "이쪽으로 오세요!"

#: deathforth/events/finale/ending-bits.df:204
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "HECK YEAH!"
msgstr "좋았어!"

#: deathforth/events/finale/ending-bits.df:211
#: deathforth/events/finale/ending-bits.df:214
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What lovely weather we've had!"
msgstr "날씨 참 좋았지!"

#: deathforth/events/finale/ending-bits.df:212
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "...are you blind, eh?"
msgstr "...너 눈 멀었냐, 응?"

#: deathforth/events/finale/ending-bits.df:215
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "YEAH?"
msgstr "그래?"

#: deathforth/events/finale/ending-bits.df:216
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "WHAT'S SO DARN LOVELY ABOUT IT?"
msgstr "대체 어디가 그렇게 좋았는데?"

#: deathforth/events/finale/ending-bits.df:223
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Hey, my purse just got bigger."
msgstr "어, 내 지갑이 방금 커졌어."

#: deathforth/events/finale/ending-bits.df:224
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "...I'M LOADED!"
msgstr "...나 부자다!"

#: deathforth/events/finale/ending-bits.df:227
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What will you spend your share on?"
msgstr "네 몫은 어디다 쓸 거야?"

#: deathforth/events/finale/ending-bits.df:228
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Hmm...."
msgstr "흠...."

#: deathforth/events/finale/ending-bits.df:229
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "MORE DOGS!"
msgstr "개를 더!"

#: deathforth/events/finale/ending-bits.df:230
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "sigh"
msgstr "한숨"

#: deathforth/events/finale/ending-bits.df:237
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Wait a minute, what's this in my pocket?"
msgstr "잠깐, 내 주머니에 이거 뭐지?"

#: deathforth/events/finale/ending-bits.df:238
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "A blank check?"
msgstr "백지수표?"

#: deathforth/events/finale/ending-bits.df:239
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "WE'RE RICCCCHHHHH!!!"
msgstr "우리 부자다아아아아!!!"

#: deathforth/events/finale/ending-bits.df:240
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "AND WE ONLY HAD TO ALMOST DIE FOR IT!"
msgstr "게다가 거의 죽을 뻔한 것만으로 얻었어!"

#: deathforth/events/finale/ending-bits.df:241
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Don't spend it all in one place!"
msgstr "한 번에 다 쓰지 마!"

#: deathforth/events/finale/ending-bits.df:247
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Hahaha, we made it! We actually made it!"
msgstr "하하하, 해냈다! 진짜로 해냈어!"

#: deathforth/events/finale/ending-bits.df:248
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I need a new pair of pants!"
msgstr "새 바지가 필요해!"

#: deathforth/events/finale/ending-bits.df:249
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I can point you to a good overalls store."
msgstr "괜찮은 멜빵바지 가게를 알려 줄게."

#: deathforth/events/finale/ending-bits.df:250
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You'll fit right in."
msgstr "딱 어울릴 거야."

#: deathforth/events/finale/ending-bits.df:256
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Aueghh...I think I'm going to hurl..."
msgstr "우욱... 토할 것 같아..."

#: deathforth/events/finale/ending-bits.df:257
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Puking is allowed. Just don't explode, please."
msgstr "토하는 건 괜찮아. 폭발만 하지 마, 제발."

#: deathforth/events/finale/ending-bits.df:258
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "EXPLODE?"
msgstr "폭발?"

#: deathforth/events/finale/ending-bits.df:259
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "...long story. Don't worry about it."
msgstr "...얘기가 길어. 신경 쓰지 마."

#: deathforth/events/finale/ending-bits.df:266
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You're lucky to even be alive!"
msgstr "살아 있는 것만 해도 운이 좋은 거야!"

#: deathforth/events/finale/ending-bits.df:267
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Congratulations on making it, eh?"
msgstr "도착한 거 축하해, 응?"

#: deathforth/events/finale/ending-bits.df:268
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What'll you do first, now you're in Canada?"
msgstr "캐나다에 왔으니 제일 먼저 뭐 할 거야?"

#: deathforth/events/finale/ending-bits.df:272
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Make the world's biggest bowl of nachos."
msgstr "세상에서 제일 큰 나초 한 그릇 만들기."

#: deathforth/events/finale/ending-bits.df:274
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Wrestle with some meese!"
msgstr "무스랑 레슬링하기!"

#: deathforth/events/finale/ending-bits.df:278
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I'm not sure. I've not made up my mind yet."
msgstr "글쎄. 아직 못 정했어."

#: deathforth/events/finale/ending-bits.df:279
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "LAAAAAMEEEEEE. I WANNA DROWN IN POUTINE!"
msgstr "시시해애애애. 난 푸틴에 빠져 죽을래!"

#: deathforth/events/finale/ending-bits.df:281
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Unsure...I still need to think about it."
msgstr "글쎄... 아직 생각 좀 해 봐야겠어."

#: deathforth/events/finale/ending-bits.df:282
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What is there to think about? They have Tim Hortons!"
msgstr "생각할 게 뭐 있어? 팀 홀튼이 있잖아!"

#: deathforth/events/finale/ending-bits.df:287
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Sounds good to me. Can I join?"
msgstr "좋은데. 나도 껴도 돼?"

#: deathforth/events/finale/ending-bits.df:289
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Right, because that's a VERY normal thing to do."
msgstr "그래, 그게 '아주' 평범한 일이지."

#: deathforth/events/finale/ending-bits.df:297
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I LOVE BEIN STRONG"
msgstr "난 강한 게 좋아"

#: deathforth/events/finale/ending-bits.df:298
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I ALSO LOVE: NOT DYING."
msgstr "그리고 이것도 좋아: 안 죽는 거."

#: deathforth/events/finale/ending-bits.df:312
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "More penguins!"
msgstr "펭귄 또 있다!"

#: deathforth/events/finale/ending-bits.df:319
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You made it, but there's an even longer road mode!"
msgstr "해냈구나. 그런데 더 긴 길 모드도 있어!"

#: deathforth/events/finale/ending-bits.df:325
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Lots of interesting people on the Death Road!"
msgstr "데스 로드엔 흥미로운 사람이 많지!"

#: deathforth/events/finale/ending-bits.df:331
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Welcome to Canada!"
msgstr "캐나다에 온 걸 환영해!"

#: deathforth/events/finale/ending-bits.df:337
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "FEH"
msgstr "흥"

#: deathforth/events/finale/ending-bits.df:338
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "WHAT WAS SO RARE ABOUT THESE CHARACTERS?"
msgstr "이 캐릭터들이 뭐가 그렇게 희귀했다는 거야?"

#: deathforth/events/finale/ending-bits.df:344
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "WOW! WHAT A BUNCH OF JERKS!"
msgstr "와! 얼간이 집합소구먼!"

#: deathforth/events/finale/ending-bits.df:346
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "WITH FRIENDS LIKE THESE..."
msgstr "이런 친구들이 있으면..."

#: deathforth/events/finale/ending-bits.df:347
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "WHO NEEDS ENEMIES??"
msgstr "적이 왜 필요해??"

#: deathforth/events/finale/ending-bits.df:354
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Congratulations! You saved Kepa!"
msgstr "축하해! 케파를 구했구나!"

#: deathforth/events/finale/ending-bits.df:355
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You are a true Death Road-er!"
msgstr "넌 진정한 데스 로더야!"

#: deathforth/events/finale/ending-bits.df:357
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "But... did you truly win?"
msgstr "그런데... 정말 이긴 걸까?"

#: deathforth/events/finale/ending-bits.df:358
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Where did you lose Kepa?"
msgstr "케파는 어디서 잃어버렸어?"

#: deathforth/events/finale/ending-bits.df:365
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I hope the trip didn't take too long for you!"
msgstr "여행이 너무 길지 않았길 바라!"

#: deathforth/events/finale/ending-bits.df:371
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You took the scenic route, eh?"
msgstr "경치 좋은 길로 왔구먼, 응?"

#: deathforth/events/finale/ending-bits.df:377
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Could have been worse!"
msgstr "더 나쁠 수도 있었어!"

#: deathforth/events/finale/ending-bits.df:383
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "This was supposed to be Endless!"
msgstr "이거 무한이라며!"

#: deathforth/events/finale/ending-bits.df:384
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "What a rip-off!"
msgstr "사기잖아!"

#: deathforth/events/finale/ending-bits.df:390
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "WOW! SO OVERPOWERED!"
msgstr "와! 완전 사기다!"

#: deathforth/events/finale/ending-bits.df:396
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Took the shortcut, eh?"
msgstr "지름길로 왔구먼, 응?"

#: deathforth/events/finale/ending-bits.df:403
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You got your passport?"
msgstr "여권 챙겼어?"

#: deathforth/events/finale/ending-bits.df:405
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You guys got your passports?"
msgstr "너희 여권 챙겼어?"

#: deathforth/events/finale/ending-bits.df:412
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Can't believe we're still getting tourists!"
msgstr "아직도 관광객이 온다니 믿기지가 않네!"

#: deathforth/events/finale/ending-bits.df:418
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Nobody has any symptoms, right?"
msgstr "아무도 증상 없지, 그치?"

#: deathforth/events/finale/ending-bits.df:424
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Sorry you didn't get to level 12!"
msgstr "12레벨까지 못 가서 아쉽다!"

#: deathforth/events/finale/ending-bits.df:430
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Just last week I had my car smited by a lightning bolt."
msgstr "지난주에 내 차가 번개를 정통으로 맞았지 뭐야."

#: deathforth/events/finale/ending-bits.df:437
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "You look out of breath. Is everything oke?"
msgstr "숨이 차 보이네. 괜찮아?"

#: deathforth/events/finale/ending-bits.df:443
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Okay...so they're yellow?"
msgstr "그래... 그러니까 노랗다고?"

#: deathforth/events/finale/ending-bits.df:449
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "I thought I saw graphite on the ground."
msgstr "땅에 흑연이 보인 것 같았는데."

#: deathforth/events/finale/ending-bits.df:450
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Hmph. Guess not."
msgstr "흠. 아닌가 보네."

#: deathforth/events/finale/ending-bits.df:456
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "Jumpscare in 3...2...1..."
msgstr "깜짝 놀래키기 3...2...1..."

#: deathforth/events/finale/ending-bits.df:465
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "NNNNNNNNNNG."
msgstr "으으으으으으윽."

#: deathforth/events/finale/ending-bits.df:467
msgctxt "deathforth/events/finale/ending-bits.df"
msgid "WHOA! NICE?"
msgstr "우와! 좋은 건가?"

#: deathforth/events/finale/epilogue-check.df:20
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "his"
msgstr "그의"

#: deathforth/events/finale/epilogue-check.df:20
#: deathforth/events/finale/epilogue-check.df:21
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "her"
msgstr "그녀"

#: deathforth/events/finale/epilogue-check.df:21
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "him"
msgstr "그"

#: deathforth/events/finale/epilogue-check.df:22
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "he"
msgstr "그"

#: deathforth/events/finale/epilogue-check.df:22
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "she"
msgstr "그녀"

#: deathforth/events/finale/epilogue-check.df:31
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Canada is going to be great!"
msgstr "캐나다는 끝내줄 거야!"

#: deathforth/events/finale/epilogue-check.df:32
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "This was definitely worth all the carnage!"
msgstr "이 대학살을 겪을 가치가 충분했어!"

#: deathforth/events/finale/epilogue-check.df:33
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "That wasn't so bad!"
msgstr "그렇게 나쁘진 않았네!"

#: deathforth/events/finale/epilogue-check.df:34
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'm sorry that the journey is over now!"
msgstr "여정이 이제 끝나서 아쉬워!"

#: deathforth/events/finale/epilogue-check.df:39
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "It's too cold here!"
msgstr "여기 너무 추워!"

#: deathforth/events/finale/epilogue-check.df:40
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "My feet hurt!"
msgstr "발 아파!"

#: deathforth/events/finale/epilogue-check.df:41
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I already hate Canada! Canada smells bad!"
msgstr "벌써 캐나다가 싫어! 캐나다 냄새나!"

#: deathforth/events/finale/epilogue-check.df:42
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I can't believe I marched all the way here!"
msgstr "여기까지 걸어왔다니 믿기지 않아!"

#: deathforth/events/finale/epilogue-check.df:43
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Canada is bad! Downvoted!"
msgstr "캐나다 별로! 비추!"

#: deathforth/events/finale/epilogue-check.df:48
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Nice job."
msgstr "잘했어."

#: deathforth/events/finale/epilogue-check.df:49
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Good."
msgstr "좋아."

#: deathforth/events/finale/epilogue-check.df:50
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "What's next?"
msgstr "다음은?"

#: deathforth/events/finale/epilogue-check.df:51
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Easy."
msgstr "쉽네."

#: deathforth/events/finale/epilogue-check.df:56
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'm pumped! I'm PUMPED!"
msgstr "흥분된다! 완전 흥분된다고!"

#: deathforth/events/finale/epilogue-check.df:57
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Woooooo!"
msgstr "우와아아아!"

#: deathforth/events/finale/epilogue-check.df:58
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Extreeeeeme!"
msgstr "익스트리이이임!"

#: deathforth/events/finale/epilogue-check.df:59
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "AAAAAAAAAAAAAAAARGH! I DID IT!"
msgstr "아아아아아아아아아악! 해냈다!"

#: deathforth/events/finale/epilogue-check.df:64
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "All according to plan!"
msgstr "모든 게 계획대로야!"

#: deathforth/events/finale/epilogue-check.df:65
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "My prediction was a 90% chance of reaching Canada!"
msgstr "캐나다 도착 확률을 90%로 예측했지!"

#: deathforth/events/finale/epilogue-check.df:66
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I learned a lot about myself. And zombies."
msgstr "나 자신에 대해 많이 배웠어. 좀비에 대해서도."

#: deathforth/events/finale/epilogue-check.df:67
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I bet I could get here even easier, knowing what I do now."
msgstr "지금 아는 걸로 다시 하면 더 쉽게 올 수 있을 텐데."

#: deathforth/events/finale/epilogue-check.df:72
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Are we there yet?"
msgstr "아직 멀었어?"

#: deathforth/events/finale/epilogue-check.df:73
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Is this Canada?"
msgstr "여기가 캐나다야?"

#: deathforth/events/finale/epilogue-check.df:74
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Huuuuuuh? Oh, I made it."
msgstr "으으으음? 아, 도착했네."

#: deathforth/events/finale/epilogue-check.df:75
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Where am I? I wasn't paying attention."
msgstr "여기 어디야? 딴생각하고 있었어."

#: deathforth/events/finale/epilogue-check.df:80
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "We did it!"
msgstr "우리가 해냈어!"

#: deathforth/events/finale/epilogue-check.df:81
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "This is all thanks to teamwork!"
msgstr "이게 다 팀워크 덕분이야!"

#: deathforth/events/finale/epilogue-check.df:82
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Let's be friends 5ever!"
msgstr "우리 5원히 친구 하자!"

#: deathforth/events/finale/epilogue-check.df:83
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Friendship is the reason we made it!"
msgstr "우정 덕분에 여기까지 왔어!"

#: deathforth/events/finale/epilogue-check.df:88
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "No! I'm the only one!"
msgstr "안 돼! 나 혼자뿐이야!"

#: deathforth/events/finale/epilogue-check.df:89
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Here's to the ones that didn't make it."
msgstr "도착하지 못한 이들을 위하여."

#: deathforth/events/finale/epilogue-check.df:90
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Well uh... crap. Guess I'm alone."
msgstr "어... 젠장. 나 혼자네."

#: deathforth/events/finale/epilogue-check.df:91
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Err woops. Well, who needs friends I guess."
msgstr "어 이런. 뭐, 친구 따위 누가 필요해."

#: deathforth/events/finale/epilogue-check.df:96
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Nice, a whole new country to rob."
msgstr "좋아, 털어먹을 새 나라가 통째로 생겼군."

#: deathforth/events/finale/epilogue-check.df:97
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I knew that I'd make it hhhhheh."
msgstr "내가 해낼 줄 알았지 흐흐흐흐흣."

#: deathforth/events/finale/epilogue-check.df:98
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'll rule this place!"
msgstr "이곳은 내가 지배한다!"

#: deathforth/events/finale/epilogue-check.df:99
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Look at all these suckers. I'll do fine here."
msgstr "호구들 천지네. 여기선 잘 지내겠어."

#: deathforth/events/finale/epilogue-check.df:104
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I punched a moose so hard that it exploded!"
msgstr "무스를 너무 세게 때려서 터져 버렸어!"

#: deathforth/events/finale/epilogue-check.df:105
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "AAAAAAAAAARGH! AAAAARGH!"
msgstr "아아아아아아아악! 아아아아악!"

#: deathforth/events/finale/epilogue-check.df:106
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "BERSEEEERKEEEEEEEER!"
msgstr "버서어어어어커어어어어!"

#: deathforth/events/finale/epilogue-check.df:107
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I love 'zerkin!!!"
msgstr "광폭화가 좋아!!!"

#: deathforth/events/finale/epilogue-check.df:112
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I made it!"
msgstr "해냈다!"

#: deathforth/events/finale/epilogue-check.df:113
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Time to enjoy the Canadian way of life!"
msgstr "이제 캐나다식 삶을 즐길 시간!"

#: deathforth/events/finale/epilogue-check.df:114
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "That's enough zombies for me, thanks."
msgstr "좀비는 이걸로 충분해, 고마워."

#: deathforth/events/finale/epilogue-check.df:115
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Wait! I left my toothbrush in Florida!"
msgstr "잠깐! 칫솔을 플로리다에 두고 왔어!"

#: deathforth/events/finale/epilogue-check.df:116
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Touchdooooown!"
msgstr "터치다아아아운!"

#: deathforth/events/finale/epilogue-check.df:117
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "That was a lot of zombies."
msgstr "좀비 진짜 많았다."

#: deathforth/events/finale/epilogue-check.df:118
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'm going to need a new car..."
msgstr "새 차가 필요하겠는데..."

#: deathforth/events/finale/epilogue-check.df:119
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I feel insecure with no throwing chairs in sight."
msgstr "던질 의자가 안 보이니 불안해."

#: deathforth/events/finale/epilogue-check.df:120
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I hope I can loot more toilets later."
msgstr "나중에 변기를 더 뒤질 수 있으면 좋겠다."

#: deathforth/events/finale/epilogue-check.df:121
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Time to kick back and relax."
msgstr "이제 느긋하게 쉴 시간."

#: deathforth/events/finale/epilogue-check.df:122
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Victory!"
msgstr "승리!"

#: deathforth/events/finale/epilogue-check.df:123
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I deserve a vacation."
msgstr "나 휴가 갈 자격 있어."

#: deathforth/events/finale/epilogue-check.df:124
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Does it always snow here?"
msgstr "여긴 맨날 눈 와?"

#: deathforth/events/finale/epilogue-check.df:125
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Party time!"
msgstr "파티 타임!"

#: deathforth/events/finale/epilogue-check.df:126
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Congratulations!"
msgstr "축하해!"

#: deathforth/events/finale/epilogue-check.df:127
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Whoaaaa!"
msgstr "우와아아아!"

#: deathforth/events/finale/epilogue-check.df:128
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "This is all thanks to me!"
msgstr "이게 다 내 덕분이야!"

#: deathforth/events/finale/epilogue-check.df:133
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "This is just like in my Japanese animes!"
msgstr "딱 내가 보던 일본 애니 같아!"

#: deathforth/events/finale/epilogue-check.df:134
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "They made fun of my anime figurines but who's laughing NOW?"
msgstr "내 애니 피규어 놀리던 놈들, 이제 누가 웃나 보자!"

#: deathforth/events/finale/epilogue-check.df:135
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Is there Canadian anime?"
msgstr "캐나다 애니도 있어?"

#: deathforth/events/finale/epilogue-check.df:136
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "This is all thanks to the superiority of Japanese weaponry!"
msgstr "이게 다 일본 무기의 우월함 덕분이야!"

#: deathforth/events/finale/epilogue-check.df:142
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Justice triumphs!"
msgstr "정의는 승리한다!"

#: deathforth/events/finale/epilogue-check.df:143
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "HEART BEAM!"
msgstr "하트 빔!"

#: deathforth/events/finale/epilogue-check.df:145
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Well, I didn't explode this time so that's nice."
msgstr "뭐, 이번엔 폭발 안 해서 다행이네."

#: deathforth/events/finale/epilogue-check.df:150
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "TOO SWOLE TO CONTROL, BABY!!!"
msgstr "너무 우람해서 감당 불가다, 베이비!!!"

#: deathforth/events/finale/epilogue-check.df:151
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I HAVE REACHED MAXIMUM SWOLE!"
msgstr "최대 우람함에 도달했다!"

#: deathforth/events/finale/epilogue-check.df:152
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "YEAH!!!!!! TOO SWOLE!"
msgstr "예에!!!!!! 너무 우람해!"

#: deathforth/events/finale/epilogue-check.df:153
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I LOVE BEIN STRONG!!!"
msgstr "난 강한 게 좋아!!!"

#: deathforth/events/finale/epilogue-check.df:158
#: deathforth/events/finale/epilogue-check.df:326
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'll always be your bodyguard."
msgstr "난 언제까지나 네 보디가드야."

#: deathforth/events/finale/epilogue-check.df:159
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Iiiiii-I-Iiiiiii... wiiiilll always love yoooouuuuu."
msgstr "앤-다-아아아이... 윌 올웨이즈 러브 유우우우우."

#: deathforth/events/finale/epilogue-check.df:160
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Get down, Mr Prime Minister!"
msgstr "엎드리세요, 총리님!"

#: deathforth/events/finale/epilogue-check.df:161
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'm still on alert. I'm assessing threats."
msgstr "아직 경계 중이다. 위협을 평가하고 있다."

#: deathforth/events/finale/epilogue-check.df:166
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Gotta go fast!"
msgstr "빠르게 가야 해!"

#: deathforth/events/finale/epilogue-check.df:167
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Way past cool."
msgstr "쿨함 그 이상."

#: deathforth/events/finale/epilogue-check.df:168
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Eat that, Dr. Robotnik!"
msgstr "이거나 먹어라, 닥터 로보트닉!"

#: deathforth/events/finale/epilogue-check.df:169
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'm faster than Sonic the Hedgehog!"
msgstr "난 고슴도치 소닉보다 빠르다!"

#: deathforth/events/finale/epilogue-check.df:174
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I've satisfied my hunger... for victory!"
msgstr "배고픔을 채웠다... 승리에 대한!"

#: deathforth/events/finale/epilogue-check.df:175
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I was getting tired of eating canned food."
msgstr "통조림만 먹는 거 질려 가던 참이야."

#: deathforth/events/finale/epilogue-check.df:176
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I need another meal."
msgstr "한 끼 더 먹어야겠어."

#: deathforth/events/finale/epilogue-check.df:177
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Are you gunna eat that? Cause I will."
msgstr "그거 먹을 거야? 안 먹으면 내가 먹는다."

#: deathforth/events/finale/epilogue-check.df:182
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "BARK!"
msgstr "멍!"

#: deathforth/events/finale/epilogue-check.df:183
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "WOOF! WOOF!"
msgstr "왈! 왈!"

#: deathforth/events/finale/epilogue-check.df:184
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "BORK!"
msgstr "멍멍!"

#: deathforth/events/finale/epilogue-check.df:185
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "BJORK!"
msgstr "뵤크!"

#: deathforth/events/finale/epilogue-check.df:186
#: deathforth/events/finale/epilogue-check.df:225
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "WOOF!"
msgstr "왈!"

#: deathforth/events/finale/epilogue-check.df:187
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "farts.*"
msgstr "방귀를 뀐다.*"

#: deathforth/events/finale/epilogue-check.df:188
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "licks itself.*"
msgstr "자기 몸을 핥는다.*"

#: deathforth/events/finale/epilogue-check.df:209
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Feh! I can't believe I was convinced to leave my cabin."
msgstr "쳇! 오두막을 떠나라는 말에 넘어가다니."

#: deathforth/events/finale/epilogue-check.df:210
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Merry Christmas to all!"
msgstr "모두 메리 크리스마스!"

#: deathforth/events/finale/epilogue-check.df:211
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "HO!HO!HO!HO!HO!HO!HO!HO!HO!HO!HO!HO!HO!"
msgstr "호!호!호!호!호!호!호!호!호!호!호!호!호!"

#: deathforth/events/finale/epilogue-check.df:212
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "burbleburble"
msgstr "부글부글"

#: deathforth/events/finale/epilogue-check.df:213
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "All that training came in handy!"
msgstr "그동안의 훈련이 쓸모가 있었어!"

#: deathforth/events/finale/epilogue-check.df:214
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "That was a good battle. I guess."
msgstr "좋은 싸움이었어. 아마도."

#: deathforth/events/finale/epilogue-check.df:215
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "That made me think of a new wrestling move! The MECHA PRESS!"
msgstr "덕분에 새 레슬링 기술이 떠올랐어! 메카 프레스!"

#: deathforth/events/finale/epilogue-check.df:216
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "One-two... one-two... I'm brutal and ruthless!"
msgstr "원투... 원투... 난 잔혹하고 무자비하다!"

#: deathforth/events/finale/epilogue-check.df:217
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Knowledge triumphs again! I rule."
msgstr "지식이 또 이겼다! 내가 최고."

#: deathforth/events/finale/epilogue-check.df:218
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I need more cat food!"
msgstr "고양이 사료가 더 필요해!"

#: deathforth/events/finale/epilogue-check.df:219
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'm going to need some stylish winter clothes..."
msgstr "멋진 겨울옷이 좀 필요하겠는데..."

#: deathforth/events/finale/epilogue-check.df:220
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "What an enchanting land!"
msgstr "정말 매혹적인 땅이군!"

#: deathforth/events/finale/epilogue-check.df:221
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "That was easy! Rollerderby's more dangerous."
msgstr "쉬웠어! 롤러 더비가 더 위험해."

#: deathforth/events/finale/epilogue-check.df:223
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I never believed I'd make it!"
msgstr "내가 해낼 줄은 꿈에도 몰랐어!"

#: deathforth/events/finale/epilogue-check.df:224
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Hhhhheh I'll be running this place in a week, tops."
msgstr "흐흐흐흣 일주일 안에 여기를 내가 굴리게 될 거다."

#: deathforth/events/finale/epilogue-check.df:226
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "AM I FINALLY TOO SWOLE?"
msgstr "나 드디어 너무 우람해진 건가?"

#: deathforth/events/finale/epilogue-check.df:227
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Yes!"
msgstr "좋아!"

#: deathforth/events/finale/epilogue-check.df:228
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "gobble gobble"
msgstr "꾸룩 꾸룩"

#: deathforth/events/finale/epilogue-check.df:229
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "HA! TIME FOR A NEW ADVENTURE!"
msgstr "하! 새로운 모험의 시간이다!"

#: deathforth/events/finale/epilogue-check.df:230
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "This is my victory!"
msgstr "이건 나의 승리다!"

#: deathforth/events/finale/epilogue-check.df:231
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I FREAKING HATE MONDAYS!"
msgstr "월요일 진짜 싫어!"

#: deathforth/events/finale/epilogue-check.df:232
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Ooo! Never forget me! Oooooo!"
msgstr "우우! 날 잊지 마! 우우우우!"

#: deathforth/events/finale/epilogue-check.df:233
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "NEIGH!"
msgstr "히히힝!"

#: deathforth/events/finale/epilogue-check.df:234
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "EEEEEEEEEEEEEEEEE!"
msgstr "이이이이이이이이이이이이이이이이이!"

#: deathforth/events/finale/epilogue-check.df:235
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "thankyouverymuch"
msgstr "땡큐베리머치"

#: deathforth/events/finale/epilogue-check.df:236
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "We really.... cleaned up!"
msgstr "우리 진짜.... 싹 쓸어 담았네!"

#: deathforth/events/finale/epilogue-check.df:237
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "I'm a mercenary.... a mercenary for hire."
msgstr "난 용병이다.... 돈 받고 일하는 용병."

#: deathforth/events/finale/epilogue-check.df:239
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Half-Life 3 is NOT coming out, sorry."
msgstr "하프라이프 3는 안 나와, 미안."

#: deathforth/events/finale/epilogue-check.df:240
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "HYAAAAAAAAAAAAAAAAAAAAAAAAAAAGH!"
msgstr "히야아아아아아아아아아아아아아악!"

#: deathforth/events/finale/epilogue-check.df:241
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "fart"
msgstr "방귀"

#: deathforth/events/finale/epilogue-check.df:242
msgctxt "deathforth/events/finale/epilogue-check.df"
msgid "Abracadabra, nerds!"
msgstr "수리수리마수리, 찐따들아!"
