msgid "this campaign's end"
msgstr "이번 캠페인의 끝"

#: deathforth/events/common/STOMACH.df:1061
msgctxt "deathforth/events/common/STOMACH.df"
msgid " anyway."
msgstr "에 닿지 못했을 거다."

#: deathforth/events/common/STOMACH.df:1062
msgctxt "deathforth/events/common/STOMACH.df"
msgid "With every passing day,"
msgstr "하루하루 지날수록,"

